@mode(host.dual)

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, match_long, parse_when);

func test_no_arguments(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.operands.len(), 0, "no operands");
    expect(!opts.all and !opts.almost_all and !opts.columns, "default listing");
    expect(!opts.recursive and !opts.classify and !opts.reverse and !opts.directory, "no flags");
    expect(!opts.help and !opts.version, "no help or version");
}

func test_combined_short_options(): void {
    let opts = parse_args(["-aRFrd"]).unwrap();
    expect(opts.all and opts.recursive and opts.classify, "-a -R -F");
    expect(opts.reverse and opts.directory, "-r -d");
}

func test_last_of_a_and_A_wins(): void {
    let a = parse_args(["-A", "-a"]).unwrap();
    expect(a.all and !a.almost_all, "-A -a");
    let big_a = parse_args(["-aA"]).unwrap();
    expect(big_a.almost_all and !big_a.all, "-aA");
}

func test_last_of_one_and_C_wins(): void {
    expect(parse_args(["-1C"]).unwrap().columns, "-1C");
    expect(!parse_args(["-C", "-1"]).unwrap().columns, "-C -1");
}

func test_options_anywhere(): void {
    let opts = parse_args(["dir", "-F", "file"]).unwrap();
    expect(opts.classify, "-F after an operand");
    expectEq(opts.operands.len(), 2, "two operands");
    expectEq(opts.operands[1], "file", "order kept");
}

func test_double_dash_and_lone_dash(): void {
    let opts = parse_args(["--", "-a", "-"]).unwrap();
    expect(!opts.all, "-a after -- is an operand");
    expectEq(opts.operands[0], "-a", "literal -a");
    expectEq(opts.operands[1], "-", "lone dash");
}

func test_long_options_and_prefixes(): void {
    let opts = parse_args(["--all", "--rec", "--reverse", "--dir", "--classify"]).unwrap();
    expect(opts.all and opts.recursive and opts.reverse, "--all --rec --reverse");
    expect(opts.directory and opts.classify, "--dir --classify");
    expect(parse_args(["--almost"]).unwrap().almost_all, "--almost");
    expectEq(match_long("he").unwrap(), "help", "--he");
}

func test_ambiguous_and_unknown_long_options(): void {
    expectEq(parse_args(["--re"]).unwrap_err(),
        "option '--re' is ambiguous; possibilities: '--reverse' '--recursive'", "--re");
    expectEq(parse_args(["--bogus=1"]).unwrap_err(), "unrecognized option '--bogus=1'", "--bogus=1");
    expectEq(parse_args(["--all=x"]).unwrap_err(), "option '--all' doesn't allow an argument", "--all=x");
}

func test_invalid_short_option(): void {
    expectEq(parse_args(["-az"]).unwrap_err(), "invalid option -- 'z'", "-z");
    expectEq(parse_args(["-l"]).unwrap_err(), "invalid option -- 'l'", "-l is not supported");
}

func test_classify_when(): void {
    expect(parse_when("always").unwrap(), "always");
    expect(parse_when("force").unwrap(), "force");
    expect(!parse_when("never").unwrap(), "never");
    expect(!parse_when("auto").unwrap(), "auto: not a terminal");
    expect(!parse_when("n").unwrap(), "n: never, no and none agree");
    expect(parse_when("al").unwrap(), "al: always");
    expect(parse_when("a").is_err(), "a: always or auto");
    expect(parse_when("x").unwrap_err().startsWith("invalid argument 'x' for '--classify'"), "x");
    expect(!parse_args(["-F", "--classify=never"]).unwrap().classify, "--classify=never");
}

func test_help_and_version(): void {
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--version"]).unwrap().version, "--version");
}
