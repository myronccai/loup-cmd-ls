@mode(host.dual)

# Tests for ls's exit statuses, through cli.app.run with whole command lines.
# These tests print the program's normal output and error messages, and list
# tests/fixtures/, so run them from the repository root.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test per
# `func test_*()`. It is not part of the binary.

from debug.assert import (expectEq);
from appinfo import (EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.app import (run, usage_status);

func test_version_succeeds(): void {
    expectEq(run(["--version"]), EXIT_OK, "--version");
}

func test_help_succeeds(): void {
    expectEq(run(["--help"]), EXIT_OK, "--help");
}

func test_listing_succeeds(): void {
    expectEq(run(["tests/fixtures/tree"]), EXIT_OK, "ls DIR");
}

func test_unknown_option_is_usage_error(): void {
    expectEq(run(["-l"]), EXIT_USAGE, "-l");
}

func test_bad_classify_argument_is_status_1(): void {
    expectEq(usage_status("invalid argument 'x' for '--classify'"), EXIT_FAILURE, "argmatch");
    expectEq(usage_status("invalid option -- 'z'"), EXIT_USAGE, "getopt");
}
