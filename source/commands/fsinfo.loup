@mode(host.dual)

# What ls can find out about a path with io.fs, which has no stat() or
# lstat(): `isDir`, `isFile` and `exists` follow symbolic links, and
# `listDir` lists names. Two consequences, and how this module copes:
#
# - A dangling symbolic link makes `exists` false although the directory
#   entry is there; `entry_present` looks the name up in its directory.
# - A symbolic link to a directory looks like the directory. The kernel
#   resolves `link/..` to the parent of the link's target, so for a real
#   directory `dir/..` lists the same names as the directory that contains
#   `dir`, and for a link it (almost always) does not. `is_symlinked_dir`
#   uses that to keep -R out of linked directories and to mark them `@`.
#
# The native build's io.fs never throws (a missing directory lists as empty);
# the Stage0 interpreter used by `make test` throws IoError. Both are handled.

from io.fs import (exists, isDir, isFile, listDir);
from io.path import (basename, dirname);

pub enum Kind {
    File,
    Dir,
    # A directory reached through a symbolic link.
    LinkDir,
    # A symbolic link whose target does not exist.
    Dangling,
    # Something that exists but is neither a file nor a directory (a FIFO, a
    # socket, a device).
    Other,
    Missing,
}

# `dir/name`, without doubling a trailing slash (GNU's file_name_concat).
pub func join_path(dir: string, name: string): string {
    if (dir.endsWith("/")) {
        return dir + name;
    }
    return dir + "/" + name;
}

# The reason in an IoError message such as
# "list_dir failed on 'x': Permission denied (os error 13)".
pub func os_reason(message: string): string {
    var text = message;
    let at = text.index_of("': ");
    if (at >= 0) {
        text = text.slice(at + 3);
    }
    let os = text.index_of(" (os error");
    if (os >= 0) {
        text = text.slice(0, os);
    }
    return text;
}

# The names in a directory, in the host's order, or the reason it could not
# be read.
pub func read_names(path: string): Result[list[string], string] {
    try {
        var out: list[string] = [];
        for (name in listDir(path)) {
            out.push(name);
        }
        return Ok(out);
    } catch (IoError as e) {
        return Err(os_reason(e.message));
    }
}

# A copy of the names in byte order.
pub func sorted_names(names: list[string]): list[string] {
    var out: list[string] = [];
    for (name in names) {
        out.push(name);
    }
    out.sort(func(a: string, b: string): int { return a.compareTo(b); });
    return out;
}

# One string that is equal for two directories exactly when they hold the
# same names (a name cannot contain `/`).
pub func names_key(names: list[string]): string {
    return sorted_names(names).join("/");
}

func listing_key(path: string): string {
    return match read_names(path) {
        Ok(names) => names_key(names),
        Err(reason) => "",
    };
}

# Whether there is a directory entry at `path`, even a dangling link.
pub func entry_present(path: string): bool {
    if (exists(path)) {
        return true;
    }
    let name = basename(path);
    if (name == "" or name == "." or name == "..") {
        return false;
    }
    return match read_names(dirname(path)) {
        Ok(names) => names.contains(name),
        Err(reason) => false,
    };
}

# Whether the directory `path` is reached through a symbolic link, judged by
# whether `path/..` holds the names in `parent_key` (the names_key of the
# directory that contains `path`). A path ending in `/`, `.` or `..` is
# taken as a directory: GNU ls follows a link named with a trailing slash.
pub func is_symlinked_dir(path: string, parent_key: string): bool {
    let name = basename(path);
    if (path.endsWith("/") or name == "" or name == "." or name == "..") {
        return false;
    }
    return listing_key(join_path(path, "..")) != parent_key;
}

# What a command-line operand is. Linked directories are told apart only
# when `detect_links` is set (for -F), since GNU ls otherwise follows them.
pub func operand_kind(path: string, detect_links: bool): Kind {
    if (isDir(path)) {
        if (detect_links and is_symlinked_dir(path, listing_key(dirname(path)))) {
            return Kind.LinkDir;
        }
        return Kind.Dir;
    }
    if (isFile(path)) {
        return Kind.File;
    }
    if (exists(path)) {
        return Kind.Other;
    }
    if (!path.endsWith("/") and entry_present(path)) {
        return Kind.Dangling;
    }
    return Kind.Missing;
}

# What the entry `name` of directory `dir` is; `dir_key` is the names_key of
# `dir`'s own listing.
pub func entry_kind(dir: string, name: string, dir_key: string): Kind {
    if (name == "." or name == "..") {
        return Kind.Dir;
    }
    let path = join_path(dir, name);
    if (isDir(path)) {
        if (is_symlinked_dir(path, dir_key)) {
            return Kind.LinkDir;
        }
        return Kind.Dir;
    }
    if (isFile(path)) {
        return Kind.File;
    }
    if (exists(path)) {
        return Kind.Other;
    }
    return Kind.Dangling;
}

# Why `path` cannot be accessed: "Not a directory" when a component that
# should be a directory is a file, as in `file/` or `file/x`.
pub func missing_reason(path: string): string {
    var cur = path;
    while (cur.len() > 1 and cur.endsWith("/")) {
        cur = cur.slice(0, cur.len() - 1);
    }
    if (cur != path and exists(cur)) {
        return "Not a directory";
    }
    while (true) {
        let parent = dirname(cur);
        if (parent == cur) {
            break;
        }
        if (exists(parent)) {
            if (isDir(parent)) {
                break;
            }
            return "Not a directory";
        }
        cur = parent;
    }
    return "No such file or directory";
}
