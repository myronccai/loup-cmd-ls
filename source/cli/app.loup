@mode(host.dual)

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.ls import (run_ls);

# GNU ls exits 1 when --classify gets a bad argument (argmatch) and 2 for
# every other usage error.
pub func usage_status(msg: string): int {
    if (msg.startsWith("invalid argument") or msg.startsWith("ambiguous argument")) {
        return EXIT_FAILURE;
    }
    return EXIT_USAGE;
}

# Parses argv, runs ls and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            printErr(i"Try '{$ APP_NAME $} --help' for more information.");
            return usage_status(msg);
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_ls(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
