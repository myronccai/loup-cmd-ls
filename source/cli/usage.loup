@mode(host.dual)

# Help and version text for ls: usage() is printed by --help,
# version_line() by --version.
#
# Runtime: host.dual. Compiled into the native binary build/ls by
# `make build`; `loup run source/main.loup` interprets the same code.

from appinfo import (APP_NAME, APP_VERSION);

pub func usage(): string {
    let lines = [
        i"Usage: {$ APP_NAME $} [OPTION]... [FILE]...",
        "List information about the FILEs (the current directory by default).",
        "Sort entries alphabetically.",
        "",
        "  -a, --all                  do not ignore entries starting with .",
        "  -A, --almost-all           do not list implied . and ..",
        "  -C                         list entries by columns",
        "  -d, --directory            list directories themselves, not their contents",
        "  -F, --classify[=WHEN]      append indicator (/ or @) to entries WHEN",
        "  -r, --reverse              reverse order while sorting",
        "  -R, --recursive            list subdirectories recursively",
        "  -1                         list one file per line (the default)",
        "      --help                 display this help and exit",
        "      --version              output version information and exit",
        "",
        "WHEN is 'always' (the default if omitted), 'never' or 'auto'; 'auto' acts",
        "like 'never' because the output is not assumed to be a terminal.",
        "-C fits the columns into the width given by the COLUMNS environment",
        "variable (80 if unset; 0 means no limit).",
        "",
        "Exit status:",
        " 0  if OK,",
        " 1  if minor problems (e.g., cannot access subdirectory),",
        " 2  if serious trouble (e.g., cannot access command-line argument).",
    ];
    return lines.join("\n");
}

pub func version_line(): string {
    return i"{$ APP_NAME $} (loup-cmd-{$ APP_NAME $}) {$ APP_VERSION $}";
}
